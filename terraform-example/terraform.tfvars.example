# Copy to terraform.tfvars and fill in real values. Do not commit terraform.tfvars.

vcfa_url            = "vcfa.example.com"
vcfa_insecure        = false
vcfa_refresh_token   = "CHANGE-ME"
tenant_org           = "tf-example-org"

tenant_namespace     = "prod01-8sg7f"
region_name          = "m01-reg01"
tenant_vpc_name      = "prod01-vpc01"
security_profile_name = "system-security-profile-2--m01-reg01" # pick from: kubectl get securityprofiles
monitoring_namespace = "monitoring01-8sg7f"

# One entry per external connection, keyed by TGWAttachment (kubectl get tgwattachments)
tgw_external_connections = {
  prod-tier0 = {
    attachment_name      = "tgw-prod:jjl9"
    remote_cidrs         = ["0.0.0.0/0"]
    inbound_target_group = "app01"
    inbound_services     = [":HTTPS"]
    outbound_services    = [":DNS", ":DNS-UDP", ":HTTPS"]
  }
  dev-tier0 = {
    attachment_name      = "tgw-dev:gdwm"
    remote_cidrs         = ["0.0.0.0/0"]
    inbound_target_group = "app01"
    inbound_services     = []
    outbound_services    = [":DNS", ":DNS-UDP"]
  }
}
